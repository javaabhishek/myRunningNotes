4️⃣ Main Tabs Component (Positions / Tax Lots)
tabs.component.ts
import { Component, Input, Output, EventEmitter } from '@angular/core';

@Component({
  selector: 'app-main-tabs',
  templateUrl: './tabs.component.html'
})
export class MainTabsComponent {
  @Input() activeTab!: 'POSITIONS' | 'TAX_LOTS';
  @Output() tabChange = new EventEmitter<'POSITIONS' | 'TAX_LOTS'>();

  select(tab: 'POSITIONS' | 'TAX_LOTS') {
    this.tabChange.emit(tab);
  }
}

tabs.component.html
<div class="tabs">
  <span
    [class.active]="activeTab === 'POSITIONS'"
    (click)="select('POSITIONS')">
    Positions
  </span>

  <span
    [class.active]="activeTab === 'TAX_LOTS'"
    (click)="select('TAX_LOTS')">
    Tax Lots
  </span>
</div>

