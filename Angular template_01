<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Account – Tax Lots</title>

<style>
    body {
        font-family: Arial, sans-serif;
        background: #f4f6f8;
        margin: 0;
    }

    /* Top Menu */
    .top-nav {
        background: #1f2933;
        color: white;
        padding: 12px 20px;
        font-size: 14px;
    }

    .top-nav span {
        margin-right: 20px;
        cursor: pointer;
    }

    /* Header */
    .header {
        background: #2c3e50;
        color: white;
        padding: 20px;
    }

    .summary {
        display: flex;
        gap: 40px;
        margin-top: 10px;
        font-size: 14px;
    }

    /* Main Tabs */
    .tabs {
        background: white;
        padding: 10px 20px;
        border-bottom: 1px solid #ccc;
    }

    .tabs span {
        margin-right: 20px;
        font-weight: bold;
        cursor: pointer;
    }

    .tabs .active {
        color: #e67e22;
    }

    /* Sub Tabs */
    .sub-tabs {
        background: #eef1f4;
        padding: 10px 20px;
        border-bottom: 1px solid #ccc;
    }

    .sub-tabs span {
        margin-right: 20px;
        cursor: pointer;
        font-weight: bold;
    }

    .sub-tabs .active {
        color: #1f2933;
        text-decoration: underline;
    }

    /* Content */
    .content {
        padding: 20px;
    }

    .box {
        background: white;
        border: 1px solid #ccc;
        padding: 15px;
        margin-bottom: 10px;
    }

    .hidden {
        display: none;
    }
</style>
</head>

<body>

<!-- Top Navigation -->
<div class="top-nav">
    <span>Home</span>
    <span>Balance Sheet</span>
    <span>Reports</span>
    <span>Documents</span>
    <span>Tools</span>
    <span style="color:#f39c12;">Accounts</span>
</div>

<!-- Header -->
<div class="header">
    <h2>681065 Reynoldo Brigdon</h2>
    <div class="summary">
        <div>Market Value: <b>$984,527.76</b></div>
        <div>Accrued Income: <b>$11,480.95</b></div>
        <div>Total Value: <b>$996,008.71</b></div>
    </div>
</div>

<!-- Main Tabs -->
<div class="tabs">
    <span onclick="showPositions(this)" class="active">Positions</span>
    <span onclick="showTaxLots(this)">Tax Lots</span>
    <span>Transactions</span>
    <span>Performance</span>
</div>

<!-- TAX LOT SUB TABS -->
<div id="taxTabs" class="sub-tabs hidden">
    <span class="active" onclick="loadTax('tax1', this)">Tax_01</span>
    <span onclick="loadTax('tax2', this)">Tax_02</span>
    <span onclick="loadTax('tax3', this)">Tax_03</span>
</div>

<!-- Content -->
<div class="content">

    <!-- Positions Content -->
    <div id="positionsContent">
        <div class="box">
            <b>Positions View</b>
            <p>Cash Equivalents, Fixed Income, etc…</p>
        </div>
    </div>

    <!-- Tax Lots Content -->
    <div id="taxContent" class="hidden">
        <div id="tax1" class="box">
            <b>Tax_01 – Short Term Gains</b>
            <p>Security: US Treasury</p>
            <p>Cost Basis: $15,000</p>
            <p>Unrealized Gain: $1,348</p>
        </div>

        <div id="tax2" class="box hidden">
            <b>Tax_02 – Long Term Gains</b>
            <p>Security: Corporate Bond</p>
            <p>Cost Basis: $20,000</p>
            <p>Unrealized Gain: $2,150</p>
        </div>

        <div id="tax3" class="box hidden">
            <b>Tax_03 – Loss Harvesting</b>
            <p>Security: Money Market Fund</p>
            <p>Cost Basis: $10,000</p>
            <p>Unrealized Loss: ($320)</p>
        </div>
    </div>

</div>

<!-- JS -->
<script>
    function showTaxLots(tab) {
        setActiveMainTab(tab);
        document.getElementById("positionsContent").classList.add("hidden");
        document.getElementById("taxContent").classList.remove("hidden");
        document.getElementById("taxTabs").classList.remove("hidden");
        loadTax('tax1', document.querySelector('.sub-tabs span'));
    }

    function showPositions(tab) {
        setActiveMainTab(tab);
        document.getElementById("positionsContent").classList.remove("hidden");
        document.getElementById("taxContent").classList.add("hidden");
        document.getElementById("taxTabs").classList.add("hidden");
    }

    function loadTax(id, el) {
        document.querySelectorAll("#taxContent .box").forEach(b => b.classList.add("hidden"));
        document.getElementById(id).classList.remove("hidden");

        document.querySelectorAll(".sub-tabs span").forEach(t => t.classList.remove("active"));
        el.classList.add("active");
    }

    function setActiveMainTab(tab) {
        document.querySelectorAll(".tabs span").forEach(t => t.classList.remove("active"));
        tab.classList.add("active");
    }
</script>

</body>
</html>


