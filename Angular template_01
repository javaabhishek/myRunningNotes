2️⃣ App Component (Root Controller – like GWT EntryPoint)
app.component.ts
import { Component } from '@angular/core';

@Component({
  selector: 'app-root',
  templateUrl: './app.component.html'
})
export class AppComponent {
  activeMainTab: 'POSITIONS' | 'TAX_LOTS' = 'POSITIONS';

  switchTab(tab: 'POSITIONS' | 'TAX_LOTS') {
    this.activeMainTab = tab;
  }
}

app.component.html
<app-header></app-header>

<app-main-tabs
  [activeTab]="activeMainTab"
  (tabChange)="switchTab($event)">
</app-main-tabs>

<div class="content">
  <app-positions *ngIf="activeMainTab === 'POSITIONS'"></app-positions>
  <app-tax-lots *ngIf="activeMainTab === 'TAX_LOTS'"></app-tax-lots>
</div>

