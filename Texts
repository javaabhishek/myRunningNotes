-- Pseudocode
SELECT MAX(logindate) INTO lastLogin FROM loginhistory WHERE userid = :userid;

IF lastLogin IS NULL THEN
  INSERT INTO loginhistory(userid, logindate) VALUES (:userid, CURRENT_TIMESTAMP);
  RETURN CURRENT_TIMESTAMP;
ELSE
  -- Only insert if the last insert wasn't within a short window (e.g., 10 seconds)
  IF CURRENT_TIMESTAMP - lastLogin > 10 seconds THEN
    INSERT INTO loginhistory(userid, logindate) VALUES (:userid, CURRENT_TIMESTAMP);
  END IF;
  RETURN lastLogin;
END IF;
