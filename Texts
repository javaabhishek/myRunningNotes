import React, { createContext, useContext, useEffect, useRef, useState } from "react";
import { useAuth } from "react-oidc-context";
import { useAuthService } from "../services/AuthService";
import { vendorApis } from "../services/vendorApis";

const VendorContext = createContext();

export const useVendorContext = () => useContext(VendorContext);

export const VendorProvider = ({ children }) => {
  const isProdEnv = import.meta.env.VITE_APP_MODE === "Production";
  const [vendors, setVendors] = useState([]);
  const [loading, setLoading] = useState(true);
  const [fetched, setFetched] = useState(false);
  const [lastLogin, setLastLogin] = useState("");
  const { isAuthenticated, isLoading } = useAuthService();
  const auth = useAuth();
  const { getVendors, getLastLogin } = vendorApis();

  const loginFetchedRef = useRef(false); // 🛡️ Flag to prevent duplicate API call

  const fetchVendors = async () => {
    setLoading(true);
    const res = await getVendors();
    setVendors(res);
    setFetched(true);
    setLoading(false);
  };

  const fetchLastLogin = async () => {
    if (!auth.user?.profile?.email) return;
    const res = await getLastLogin(auth.user.profile.email);
    setLastLogin(res);
  };

  const refreshVendors = () => {
    setFetched(false); // Trigger re-fetch
  };

  const resetVendorData = () => {
    setVendors([]);
    setFetched(false);
    setLastLogin("");
    loginFetchedRef.current = false;
  };

  useEffect(() => {
    if (isLoading || !isAuthenticated) return;

    if (!fetched) {
      fetchVendors();
    }

    if (!loginFetchedRef.current && isAuthenticated) {
      fetchLastLogin();
      loginFetchedRef.current = true; // ✅ Prevent duplicate calls
    }
  }, [fetched, isAuthenticated, isLoading]);

  return (
    <VendorContext.Provider
      value={{
        loading,
        vendors,
        fetchVendors,
        refreshVendors,
        resetVendorData,
        lastLogin,
      }}
    >
      {children}
    </VendorContext.Provider>
  );
};
