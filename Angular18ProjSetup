3️⃣ Menu Generation Service (Route → Menu)
libs/shared-ui/navigation.service.ts
import { Injectable } from '@angular/core';
import { Router, Route } from '@angular/router';
import { MenuItem } from './navigation.model';

@Injectable({ providedIn: 'root' })
export class NavigationService {

  constructor(private router: Router) {}

  getMenu(): MenuItem[] {
    return this.buildMenu(this.router.config);
  }

  private buildMenu(routes: Route[], parentPath = ''): MenuItem[] {
    return routes
      .filter(r => r.data?.['menu'])
      .map(r => ({
        label: r.data!['title'],
        icon: r.data!['icon'],
        path: `${parentPath}/${r.path}`
      }));
  }
}

