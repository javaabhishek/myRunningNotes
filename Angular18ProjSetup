5️⃣ Breadcrumb Auto-Generation
libs/shared-ui/breadcrumb.service.ts
@Injectable({ providedIn: 'root' })
export class BreadcrumbService {

  build(route: ActivatedRouteSnapshot): string[] {
    const crumbs: string[] = [];

    while (route) {
      if (route.data?.['breadcrumb']) {
        crumbs.push(route.data['breadcrumb']);
      }
      route = route.firstChild!;
    }

    return crumbs;
  }
}

Breadcrumb Component
@Component({
  standalone: true,
  selector: 'app-breadcrumb',
  template: `
    <company-breadcrumb>
      <span *ngFor="let c of crumbs">{{ c }}</span>
    </company-breadcrumb>
  `
})
export class BreadcrumbComponent {
  crumbs = this.service.build(this.route.snapshot);
  constructor(
    private route: ActivatedRoute,
    private service: BreadcrumbService
  ) {}
}

