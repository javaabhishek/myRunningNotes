import { NgModule } from '@angular/core';

import { CompanyButtonModule } from '@company/ui/button';
import { CompanyTableModule } from '@company/ui/table';
import { CompanyFormModule } from '@company/ui/form';
import { CompanyChartModule } from '@company/ui/chart';
import { CompanyModalModule } from '@company/ui/modal';

@NgModule({
  imports: [
    CompanyButtonModule,
    CompanyTableModule,
    CompanyFormModule,
    CompanyChartModule,
    CompanyModalModule
  ],
  exports: [
    CompanyButtonModule,
    CompanyTableModule,
    CompanyFormModule,
    CompanyChartModule,
    CompanyModalModule
  ]
})
export class CompanyUiAggregatedModule {}


✔ One place
✔ Easy to review
✔ Easy to extend

2️⃣ Import that single module into providers
libs/company-ui/company-ui.providers.ts
import { makeEnvironmentProviders, importProvidersFrom } from '@angular/core';
import { CompanyUiAggregatedModule } from './company-ui.modules';

export function provideCompanyUi() {
  return makeEnvironmentProviders([
    importProvidersFrom(CompanyUiAggregatedModule)
  ]);
}

