6. Feature Flag Service

Large systems use feature flags.

feature-flag.service.ts

	@Injectable({ providedIn: 'root' })
	export class FeatureFlagService {

	  private flags = new Set<string>();

	  setFlags(flags: string[]) {
		this.flags = new Set(flags);
	  }

	  enabled(flag: string) {
		return this.flags.has(flag);
	  }

	}

7. Policy Service (Core Engine)

policy.service.ts

@Injectable({ providedIn: 'root' })
export class PolicyService {

  private entitlements = new Set<string>();

  constructor(private feature: FeatureFlagService) {}

  setPermissions(perms: string[]) {
    this.entitlements = new Set(perms);
  }

  can(permission: string) {
    return this.entitlements.has(permission);
  }

  canWithFeature(permission: string, featureFlag: string) {

    return (
      this.entitlements.has(permission) &&
      this.feature.enabled(featureFlag)
    );

  }

}

Components now use:

policy.can()

